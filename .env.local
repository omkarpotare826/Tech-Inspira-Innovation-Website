# Gmail credentials for contact form emails
# GMAIL_USER = the Gmail address you send FROM (can be same as inspira.innovations00@gmail.com)
# GMAIL_APP_PASS = 16-character App Password (NOT your regular password)
#
# HOW TO GET AN APP PASSWORD:
# 1. Go to https://myaccount.google.com/security
# 2. Enable "2-Step Verification" if not already on
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Choose App: "Mail", Device: "Other" → type "Tech Inspira Website" → click Generate
# 5. Copy the 16-character password shown and paste it below (no spaces)

GMAIL_USER=inspira.innovations00@gmail.com
GMAIL_APP_PASS=your_16_char_app_password_here
